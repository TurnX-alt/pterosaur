{
  "name": "pterosaur",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Pterosaur — 仿 Apple Music 的网页音乐播放器，无需登录即可畅听，支持登录网易云账号解锁 VIP。",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "type-check": "tsc -b --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "pnpm build && pnpm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "hono": "^4.13.12",
    "lru-cache": "^11.2.4",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
