# Pterosaur 环境变量示例。
# 复制为 .env（同目录，已在 .gitignore 中忽略）后按需填写。

# 服务端缺省网易云凭证：未登录访客借它解析 VIP 资源（不影响访客身份）。
# 由 `pnpm log-in` 扫码登录后自动写入，通常无需手工填写。
NETEASE_COOKIE=

# 服务端缺省 QQ 音乐凭证：未登录访客借它解析 QQ 会员曲（可选，留空即无）。
# 由你在应用内「登录」处选择 QQ 音乐扫码后、把会话 cookie 手工粘贴于此（QQ 命令行扫码暂不支持）。
QQ_COOKIE=

# 服务端缺省咪咕音乐凭证：未登录访客借它解析咪咕 VIP 曲（可选，留空即无）。
# 咪咕**无扫码登录**（其登录为手机号/短信），故需你自行获取会话 cookie 后手工粘贴于此。
MIGU_COOKIE=

# 以下均为可选，留空即用默认值：
# PORT=8788          # 后端监听端口
# HOST=0.0.0.0       # 后端监听地址
# DATA_DIR=          # 云同步数据目录（默认 <仓库根>/.data）
