# Pterosaur 环境变量示例。
# 复制为 .env（同目录，已在 .gitignore 中忽略）后按需填写。

# 服务端缺省网易云凭证：未登录访客借它解析 VIP 资源（不影响访客身份）。
# 由 `pnpm log-in` 扫码登录后自动写入，通常无需手工填写。
NETEASE_COOKIE=

# 服务端缺省 B 站会话（可选）：供未登录访客解析更高码率的 MV 音频。
# B 站可在应用内「登录」处扫码（或手工把 SESSDATA 等写入此处）。
BILIBILI_COOKIE=

# 以下均为可选，留空即用默认值：
# PORT=8788          # 后端监听端口
# HOST=0.0.0.0       # 后端监听地址
# DATA_DIR=          # 云同步数据目录（默认 <仓库根>/.data）
